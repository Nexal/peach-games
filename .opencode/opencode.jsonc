{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "trello": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-server-trello"
      ],
      "environment": {
        "TRELLO_API_KEY": "YOUR_TRELLO_API_KEY",
        "TRELLO_TOKEN": "YOUR_TRELLO_TOKEN"
      }
    },
    "notion": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    }
  },
  "plugin": [
    "opencode-websearch-cited@1.2.0"
  ],
  "permission": {
    "websearch": "allow"
  }
}