{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "trello": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-server-trello"
      ],
      "environment": {
        "TRELLO_API_KEY": "cced9296e49710b1593a24c127e1ca60",
        "TRELLO_TOKEN": "<TRELLO_TOKEN>"
      }
    },
    "notion": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp"
      ]
    }
  },
  "plugin": [
    "opencode-websearch-cited@1.2.0"
  ],
  "permission": {
    "websearch": "allow"
  }
}